+
+static uint32_t bcm2835_gpio_get_level(BCM2835GpioState *s, int bank)
+{
+    uint32_t level = bank ? s->lev1 : s->lev0;
+    int start = bank * 32;
+    int count = MIN(32, 54 - start);
+    int i;
+
+    for (i = 0; i < count; i++) {
+        int pin = start + i;
+        uint32_t mask = 1U << i;
+
+        if (s->fsel[pin] == 0) {
+            if (s->input_level[pin]) {
+                level |= mask;
+            } else {
+                level &= ~mask;
+            }
+        }
+    }
+
+    return level;
+}
+
+static void bcm2835_gpio_update_irq(BCM2835GpioState *s)
+{
+    uint32_t level[2] = {
+        bcm2835_gpio_get_level(s, 0),
+        bcm2835_gpio_get_level(s, 1),
+    };
+    uint32_t input_mask[2] = { 0, 0 };
+    bool bank_irq[3];
+    int pin;
+
+    for (pin = 0; pin < 54; pin++) {
+        if (s->fsel[pin] == 0) {
+            input_mask[pin / 32] |= 1U << (pin % 32);
+        }
+    }
+
+    s->event_status[0] |=
+        ((level[0] & s->level_high[0]) |
+         (~level[0] & s->level_low[0])) & input_mask[0];
+    s->event_status[1] |=
+        ((level[1] & s->level_high[1]) |
+         (~level[1] & s->level_low[1])) & input_mask[1];
+
+    bank_irq[0] = (s->event_status[0] & 0x0fffffff) != 0;
+    bank_irq[1] = ((s->event_status[0] & 0xf0000000) != 0) ||
+                  ((s->event_status[1] & 0x00003fff) != 0);
+    bank_irq[2] = (s->event_status[1] & 0x003fc000) != 0;
+
+    qemu_set_irq(s->irq[0], bank_irq[0]);
+    qemu_set_irq(s->irq[1], bank_irq[1]);
+    qemu_set_irq(s->irq[2], bank_irq[2]);
+    qemu_set_irq(s->irq[3], bank_irq[0] || bank_irq[1] || bank_irq[2]);
+}
+
+static void bcm2835_gpio_update_levels(BCM2835GpioState *s,
+                                        uint32_t old_level0,
+                                        uint32_t old_level1)
+{
+    uint32_t new_level[2] = {
+        bcm2835_gpio_get_level(s, 0),
+        bcm2835_gpio_get_level(s, 1),
+    };
+    uint32_t old_level[2] = { old_level0, old_level1 };
+    int pin;
+
+    for (pin = 0; pin < 54; pin++) {
+        int bank = pin / 32;
+        uint32_t mask = 1U << (pin % 32);
+        bool old = (old_level[bank] & mask) != 0;
+        bool current = (new_level[bank] & mask) != 0;
+
+        if (s->fsel[pin] != 0 || old == current) {
+            continue;
+        }
+        if (current && ((s->edge_rising[bank] |
+                         s->async_rising[bank]) & mask)) {
+            s->event_status[bank] |= mask;
+        } else if (!current && ((s->edge_falling[bank] |
+                                 s->async_falling[bank]) & mask)) {
+            s->event_status[bank] |= mask;
+        }
+    }
+
+    bcm2835_gpio_update_irq(s);
+}
+
+static void bcm2835_gpio_set_input(void *opaque, int pin, int level)
+{
+    BCM2835GpioState *s = opaque;
+    uint32_t old_level0 = bcm2835_gpio_get_level(s, 0);
+    uint32_t old_level1 = bcm2835_gpio_get_level(s, 1);
+
+    s->input_level[pin] = !!level;
+    bcm2835_gpio_update_levels(s, old_level0, old_level1);
+}
+
+static void bcm2835_gpio_get_input_property(Object *obj, Visitor *v,
+                                             const char *name, void *opaque,
+                                             Error **errp)
+{
+    BCM2835GpioState *s = BCM2835_GPIO(obj);
+    bool value = s->input_level[GPOINTER_TO_UINT(opaque)];
+
+    visit_type_bool(v, name, &value, errp);
+}
+
+static void bcm2835_gpio_set_input_property(Object *obj, Visitor *v,
+                                             const char *name, void *opaque,
+                                             Error **errp)
+{
+    BCM2835GpioState *s = BCM2835_GPIO(obj);
+    unsigned int pin = GPOINTER_TO_UINT(opaque);
+    bool value;
+
+    if (!visit_type_bool(v, name, &value, errp)) {
+        return;
+    }
+
+    qemu_set_irq(s->input[pin], value);
+    if (s->input_level[pin] != value) {
+        bcm2835_gpio_set_input(s, pin, value);
+    }
+}

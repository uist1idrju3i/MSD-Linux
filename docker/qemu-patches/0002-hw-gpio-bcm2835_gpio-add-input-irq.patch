From: MSD/Linux maintainers
Subject: [PATCH] hw/gpio: model BCM2835 GPIO inputs and interrupts

---
diff --git a/include/hw/gpio/bcm2835_gpio.h b/include/hw/gpio/bcm2835_gpio.h
--- a/include/hw/gpio/bcm2835_gpio.h
+++ b/include/hw/gpio/bcm2835_gpio.h
@@ -29,7 +29,17 @@ struct BCM2835GpioState {
     uint8_t fsel[54];
     uint32_t lev0, lev1;
     uint8_t sd_fsel;
+    uint32_t event_status[2];
+    uint32_t edge_rising[2];
+    uint32_t edge_falling[2];
+    uint32_t level_high[2];
+    uint32_t level_low[2];
+    uint32_t async_rising[2];
+    uint32_t async_falling[2];
+    bool input_level[54];
+    qemu_irq input[54];
     qemu_irq out[54];
+    qemu_irq irq[4];
 };
-
+
 #define TYPE_BCM2835_GPIO "bcm2835_gpio"
diff --git a/hw/gpio/bcm2835_gpio.c b/hw/gpio/bcm2835_gpio.c
--- a/hw/gpio/bcm2835_gpio.c
+++ b/hw/gpio/bcm2835_gpio.c
@@ -18,5 +18,6 @@
 #include "qemu/timer.h"
 #include "qapi/error.h"
+#include "qapi/visitor.h"
 #include "hw/core/sysbus.h"
 #include "migration/vmstate.h"
 #include "hw/sd/sd.h"
@@ -58,6 +59,133 @@
 #define GPPUDCLK0 0x98
 #define GPPUDCLK1 0x9C

From: MSD/Linux maintainers
Subject: [PATCH] hw/misc: add BCM2835 watchdog timer

---
diff --git a/hw/misc/bcm2835_powermgt.c b/hw/misc/bcm2835_powermgt.c
--- a/hw/misc/bcm2835_powermgt.c
+++ b/hw/misc/bcm2835_powermgt.c
@@ -11,6 +11,7 @@
 #include "qemu/osdep.h"
 #include "qemu/log.h"
 #include "qemu/module.h"
+#include "qemu/timer.h"
 #include "hw/misc/bcm2835_powermgt.h"
 #include "migration/vmstate.h"
 #include "system/runstate.h"
@@ -23,5 +24,54 @@
 #define R_RSTS 0x20
 #define V_RSTS_POWEROFF 0x555 /* Linux uses partition 63 to indicate halt. */
 #define R_WDOG 0x24
+#define WDOG_TICKS_MASK 0xfffff
+#define WDOG_TICK_RATE 65536
+
+static void bcm2835_powermgt_wdog_expired(void *opaque)
+{
+    BCM2835PowerMgtState *s = opaque;
+
+    if ((s->rsts & 0xfff) == V_RSTS_POWEROFF) {
+        qemu_system_shutdown_request(SHUTDOWN_CAUSE_GUEST_SHUTDOWN);
+    } else {
+        qemu_system_reset_request(SHUTDOWN_CAUSE_GUEST_RESET);
+    }
+}
+
+static void bcm2835_powermgt_arm_wdog(BCM2835PowerMgtState *s)
+{
+    uint64_t ticks = s->wdog & WDOG_TICKS_MASK;
+    uint64_t delay_ns =
+        (ticks * NANOSECONDS_PER_SECOND + WDOG_TICK_RATE - 1) /
+        WDOG_TICK_RATE;
+
+    timer_mod_ns(s->wdog_timer,
+                 qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + (int64_t)delay_ns);
+}
+
+static uint32_t bcm2835_powermgt_read_wdog(BCM2835PowerMgtState *s)
+{
+    int64_t now_ns;
+    int64_t expire_ns;
+    uint64_t remaining_ns;
+    uint64_t remaining_ticks;
+
+    if (!timer_pending(s->wdog_timer)) {
+        return s->wdog;
+    }
+
+    now_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    expire_ns = timer_expire_time_ns(s->wdog_timer);
+    if (expire_ns <= now_ns) {
+        return 0;
+    }
+
+    remaining_ns = (uint64_t)(expire_ns - now_ns);
+    remaining_ticks =
+        (remaining_ns * WDOG_TICK_RATE + NANOSECONDS_PER_SECOND - 1) /
+        NANOSECONDS_PER_SECOND;
+    return (uint32_t)(remaining_ticks > WDOG_TICKS_MASK ?
+                      WDOG_TICKS_MASK : remaining_ticks);
+}
 static uint64_t bcm2835_powermgt_read(void *opaque, hwaddr offset,
                                       unsigned size)
@@ -38,6 +88,6 @@
         res = s->rsts;
         break;
     case R_WDOG:
-        res = s->wdog;
+        res = bcm2835_powermgt_read_wdog(s);
         break;
     default:
@@ -70,12 +120,10 @@
     switch (offset) {
     case R_RSTC:
         s->rstc = value;
-        if (value & V_RSTC_RESET) {
-            if ((s->rsts & 0xfff) == V_RSTS_POWEROFF) {
-                qemu_system_shutdown_request(SHUTDOWN_CAUSE_GUEST_SHUTDOWN);
-            } else {
-                qemu_system_reset_request(SHUTDOWN_CAUSE_GUEST_RESET);
-            }
+        if ((value & 0x30) == V_RSTC_RESET) {
+            bcm2835_powermgt_arm_wdog(s);
+        } else {
+            timer_del(s->wdog_timer);
         }
         break;
     case R_RSTS:
@@ -86,6 +134,9 @@
     case R_WDOG:
         qemu_log_mask(LOG_UNIMP,
                       "bcm2835_powermgt_write: WDOG\n");
-        s->wdog = value;
+        s->wdog = value & WDOG_TICKS_MASK;
+        if (timer_pending(s->wdog_timer)) {
+            bcm2835_powermgt_arm_wdog(s);
+        }
         break;
     default:
@@ -107,11 +158,12 @@
 static const VMStateDescription vmstate_bcm2835_powermgt = {
     .name = TYPE_BCM2835_POWERMGT,
-    .version_id = 1,
-    .minimum_version_id = 1,
+    .version_id = 2,
+    .minimum_version_id = 2,
     .fields = (const VMStateField[]) {
         VMSTATE_UINT32(rstc, BCM2835PowerMgtState),
         VMSTATE_UINT32(rsts, BCM2835PowerMgtState),
         VMSTATE_UINT32(wdog, BCM2835PowerMgtState),
+        VMSTATE_TIMER_PTR(wdog_timer, BCM2835PowerMgtState),
         VMSTATE_END_OF_LIST()
     }
 };
@@ -124,10 +176,20 @@
     memory_region_init_io(&s->iomem, obj, &bcm2835_powermgt_ops, s,
                           TYPE_BCM2835_POWERMGT, 0x200);
     sysbus_init_mmio(SYS_BUS_DEVICE(s), &s->iomem);
+    s->wdog_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                 bcm2835_powermgt_wdog_expired, s);
+}
+
+static void bcm2835_powermgt_finalize(Object *obj)
+{
+    BCM2835PowerMgtState *s = BCM2835_POWERMGT(obj);
+
+    timer_free(s->wdog_timer);
 }
 static void bcm2835_powermgt_reset(DeviceState *dev)
 {
     BCM2835PowerMgtState *s = BCM2835_POWERMGT(dev);
+    timer_del(s->wdog_timer);
     /* https://elinux.org/BCM2835_registers#PM */
     s->rstc = 0x00000102;
     s->rsts = 0x00001000;
@@ -148,6 +210,7 @@
     .name          = TYPE_BCM2835_POWERMGT,
     .parent        = TYPE_SYS_BUS_DEVICE,
     .instance_size = sizeof(BCM2835PowerMgtState),
+    .instance_finalize = bcm2835_powermgt_finalize,
     .class_init    = bcm2835_powermgt_class_init,
     .instance_init = bcm2835_powermgt_init,
 };
diff --git a/include/hw/misc/bcm2835_powermgt.h b/include/hw/misc/bcm2835_powermgt.h
--- a/include/hw/misc/bcm2835_powermgt.h
+++ b/include/hw/misc/bcm2835_powermgt.h
@@ -13,4 +13,5 @@
 #include "hw/core/sysbus.h"
 #include "qom/object.h"
+#include "qemu/timer.h"
 #define TYPE_BCM2835_POWERMGT "bcm2835-powermgt"
 OBJECT_DECLARE_SIMPLE_TYPE(BCM2835PowerMgtState, BCM2835_POWERMGT)
@@ -24,5 +25,6 @@
     uint32_t rstc;
     uint32_t rsts;
     uint32_t wdog;
+    QEMUTimer *wdog_timer;
 };
 #endif

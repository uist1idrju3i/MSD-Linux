#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="$(cd -- "${script_dir}/.." && pwd -P)"
image="${MSD_DEV_IMAGE:-msd-dev:local}"
image_repository=ghcr.io/uist1idrju3i/msd-dev
IMAGE_INPUTS=(
    .github/zizmor-requirements.txt
    docker/debian.sources
    docker/msd-dev.Dockerfile
)

image_input_hash() {
    local input
    local file_hash
    local -a sorted_inputs

    mapfile -t sorted_inputs < <(printf '%s\n' "${IMAGE_INPUTS[@]}" | LC_ALL=C sort)

    {
        for input in "${sorted_inputs[@]}"; do
            file_hash="$(sha256sum -- "${repo_root}/${input}")"
            printf '%s  %s\n' "${file_hash%% *}" "${input}"
        done
    } | sha256sum | cut -c1-16
}

if [[ "${1:-}" == "tag" ]]; then
    if (($# != 1)); then
        printf 'Usage: %s tag\n' "$0" >&2
        exit 2
    fi
    printf 'inputs-%s\n' "$(image_input_hash)"
    exit 0
fi

if [[ "${1:-}" == "ensure" ]]; then
    if (($# != 1)); then
        printf 'Usage: %s ensure\n' "$0" >&2
        exit 2
    fi
    input_tag="$(image_input_hash)"
    source_image="${image_repository}:inputs-${input_tag}"
    if inspect_output="$(docker buildx imagetools inspect "${source_image}" 2>&1)"; then
        printf '%s\n' "${inspect_output}"
        exec "${0}" pull
    else
        inspect_status=$?
    fi
    if [[ "${inspect_output}" == *": not found"* ]]; then
        printf 'Published image %s was not found; building locally.\n' \
            "${source_image}" >&2
        exec docker build \
            -f "${repo_root}/docker/msd-dev.Dockerfile" \
            -t "${image}" \
            "${repo_root}"
    fi
    printf 'Could not inspect published image %s (exit %s): %s\n' \
        "${source_image}" "${inspect_status}" "${inspect_output}" >&2
    exit "${inspect_status}"
fi

if [[ "${1:-}" == "pull" ]]; then
    if (($# != 1)); then
        printf 'Usage: %s pull\n' "$0" >&2
        exit 2
    fi
    input_tag="$(image_input_hash)"
    source_image="${image_repository}:inputs-${input_tag}"
    docker pull "${source_image}"
    if command -v gh >/dev/null 2>&1; then
        gh attestation verify "oci://${source_image}" \
            --repo uist1idrju3i/MSD-Linux
    elif [[ "${MSD_DEV_REQUIRE_ATTESTATION:-0}" == 1 ]]; then
        printf '%s\n' \
            'Error: gh is required when MSD_DEV_REQUIRE_ATTESTATION=1.' >&2
        exit 1
    else
        printf '%s\n' \
            'Warning: gh is unavailable; attestation verification was skipped.' >&2
    fi
    docker tag "${source_image}" "${image}"
    printf 'Pulled %s as %s\n' "${source_image}" "${image}"
    exit 0
fi

if [[ "${1:-}" == "build" ]]; then
    if (($# != 1)); then
        printf 'Usage: %s build\n' "$0" >&2
        exit 2
    fi
    exec docker build -f "${repo_root}/docker/msd-dev.Dockerfile" -t "${image}" "${repo_root}"
fi

command=("$@")
if ((${#command[@]} == 0)); then
    command=(bash)
fi

tty_args=()
if [[ -t 0 ]]; then
    tty_args=(-it)
fi

docker_args=(
    run
    --rm
    "${tty_args[@]}"
    --user "$(id -u):$(id -g)"
    --env HOME=/tmp/home
    --volume "${repo_root}:/work"
    --workdir /work
    --security-opt no-new-privileges
    --cap-drop ALL
)

add_directory() {
    local name="$1"
    local host_path
    local container_path

    [[ -v "$name" ]] || return 0
    local value="${!name}"
    if [[ -z "${value}" ]]; then
        docker_args+=(--env "${name}=")
        return 0
    fi
    host_path="$(realpath -m -- "${value}")"
    mkdir -p -- "${host_path}"

    if [[ "${host_path}" == "${repo_root}" ]]; then
        container_path=/work
    elif [[ "${host_path}" == "${repo_root}/"* ]]; then
        container_path="/work/${host_path#"${repo_root}/"}"
    else
        container_path="${host_path}"
        docker_args+=(--volume "${host_path}:${container_path}")
    fi
    docker_args+=(--env "${name}=${container_path}")
}

for name in BR2_DL_DIR BR2_CCACHE_DIR OUTPUT_DIR QEMU_LOG_DIR; do
    add_directory "${name}"
done

for name in \
    QEMU_EXTRA_APPEND QEMU_BOOT_TIMEOUT CCACHE_MAXSIZE GITHUB_SHA KHC_TAG KHC_COMMIT; do
    if [[ -v "$name" ]]; then
        docker_args+=(--env "${name}=${!name}")
    fi
done

exec docker "${docker_args[@]}" \
    --entrypoint /bin/bash \
    "${image}" \
    -c 'mkdir -p -- /tmp/home && exec "$@"' \
    msd-dev \
    "${command[@]}"

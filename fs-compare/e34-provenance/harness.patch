 }
 
+open_stack()
+{
+	stack_device=$1
+	stack_mapper_name=$2
+	setup_remaining=$SETUP
+	stack_open_command=
+	stack_open_command_count=0
+	while [ -n "$setup_remaining" ]; do
+		setup_step=${setup_remaining%%;*}
+		if [ "$setup_step" = "$setup_remaining" ]; then
+			setup_remaining=
+		else
+			setup_remaining=${setup_remaining#*;}
+		fi
+		setup_step="$(printf '%s' "$setup_step" |
+			sed -e "s|%BASE_DEVICE%|$stack_device|g" \
+				-e "s|%KEYFILE%|$KEYFILE|g")"
+		# shellcheck disable=SC2086
+		set -- $setup_step
+		if [ "${1:-}" != integritysetup ] &&
+			[ "${1:-}" != cryptsetup ] ||
+			[ "${2:-}" != open ]; then
+			continue
+		fi
+		stack_open_command_count=$((stack_open_command_count + 1))
+		[ "$#" -ge 3 ] || fail "stack_open_command_missing_mapper"
+		stack_open_command=
+		while [ "$#" -gt 1 ]; do
+			if [ -z "$stack_open_command" ]; then
+				stack_open_command=$1
+			else
+				stack_open_command="$stack_open_command $1"
+			fi
+			shift
+		done
+		stack_open_command="$stack_open_command $stack_mapper_name"
+	done
+	[ "$stack_open_command_count" -eq 1 ] ||
+		fail "stack_open_command_count=$stack_open_command_count"
+	console "stack_open_command=$stack_open_command"
+	# shellcheck disable=SC2086
+	set -- $stack_open_command
+	"$@"
+}
+
 run_setup_commands()
 {
 	make_keyfiles

BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_MSD_PATH)/board/cardputerzero/linux.fragment $(BR2_EXTERNAL_MSD_PATH)/board/cardputerzero/tools/bench/fs-compare.fragment"
BR2_PACKAGE_BTRFS_PROGS=y
BR2_PACKAGE_F2FS_TOOLS=y
BR2_PACKAGE_CRYPTSETUP=y
BR2_PACKAGE_LVM2=y
# BR2_PACKAGE_LVM2_STANDARD_INSTALL is not set
BR2_PACKAGE_FSCRYPTCTL=y
BR2_PACKAGE_UTIL_LINUX_FALLOCATE=y
BR2_PACKAGE_UTIL_LINUX_LOSETUP=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y

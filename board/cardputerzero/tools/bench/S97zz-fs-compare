#!/bin/sh

case "${1:-start}" in
	start) ;;
	*) exit 0 ;;
esac

selection="$(tr ' ' '\n' </proc/cmdline | sed -n 's/^msd\.fscmp=//p')"
[ -n "$selection" ] || exit 0
phase="$(tr ' ' '\n' </proc/cmdline | sed -n 's/^msd\.fscmp\.phase=//p')"
points="$(tr ' ' '\n' </proc/cmdline | sed -n 's/^msd\.fscmp\.points=//p')"
exec /usr/libexec/fs-compare-guest "$selection" "${phase:-run}" "$points"

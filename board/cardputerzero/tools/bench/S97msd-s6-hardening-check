#!/bin/sh

case " $(cat /proc/cmdline) " in
	*" msd.s6check=1 "*)
		lsm_line="$(dmesg | grep -F 'LSM: initializing lsm=' | tail -n 1)"
		case "$lsm_line" in
			*',yama'*|*'=yama'*)
				printf 'HARDENING_CHECK: %s\n' "$lsm_line" > /dev/console
				;;
			*)
				printf 'HARDENING_CHECK: Yama missing from LSM initialization\n' > /dev/console
				exit 1
				;;
		esac

		scope="$(cat /proc/sys/kernel/yama/ptrace_scope 2>/dev/null)"
		printf 'HARDENING_CHECK: ptrace_scope=%s\n' "${scope:-missing}" > /dev/console
		[ "$scope" = 1 ] || exit 1

		if insmod /usr/lib/msd-hardening/usbnet-unsigned.ko >/tmp/msd-unsigned-module.log 2>&1; then
			printf '%s\n' 'HARDENING_CHECK: unsigned usbnet unexpectedly loaded' > /dev/console
			exit 1
		fi
		if grep -Eiq 'key|signature' /tmp/msd-unsigned-module.log; then
			printf '%s\n' 'HARDENING_CHECK: unsigned usbnet rejected (key/signature)' > /dev/console
		else
			printf '%s\n' 'HARDENING_CHECK: unsigned usbnet rejected for unexpected reason' > /dev/console
			exit 1
		fi

		if modprobe usbnet && lsmod | grep -Eq '^usbnet[[:space:]]'; then
			printf '%s\n' 'HARDENING_CHECK: signed usbnet loaded via modprobe and shown by lsmod' > /dev/console
		else
			printf '%s\n' 'HARDENING_CHECK: signed usbnet failed to load via modprobe' > /dev/console
			exit 1
		fi
		;;
esac

exit 0

#!/bin/sh

touch /run/msd-ready
case " $(cat /proc/cmdline) " in
	*" msd.module-test=usbnet "*)
		if modprobe usbnet &&
			lsmod | awk '$1 == "usbnet" { found = 1 } END { exit !found }'; then
			printf '%s\n' 'msd-module-check: usbnet loaded via modprobe and listed by lsmod' >/dev/console
		else
			printf '%s\n' 'msd-module-check: usbnet modprobe or lsmod failed' >/dev/console
		fi
		;;
esac
case " $(cat /proc/cmdline) " in
	*" msd.sweep=1 "*)
		printf '<6>MSD/Linux ready\n' > /dev/kmsg
		;;
	*)
		printf '%s\n' 'MSD/Linux ready' > /dev/console
		;;
esac

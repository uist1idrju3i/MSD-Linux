#!/bin/sh

case "${1:-start}" in
	start) ;;
	*) exit 0 ;;
esac

touch /run/msd-ready
module_list="$(sed -n 's/.*[[:space:]]msd.module-test=\([^[:space:]]*\).*/\1/p' /proc/cmdline)"
remaining_modules="$module_list"
while [ -n "$remaining_modules" ]; do
	case "$remaining_modules" in
		*,*)
			module="${remaining_modules%%,*}"
			remaining_modules="${remaining_modules#*,}"
			;;
		*)
			module="$remaining_modules"
			remaining_modules=
			;;
	esac
	[ -n "$module" ] || continue
	lsmod_name="$(printf '%s\n' "$module" | tr '-' '_')"
	if modprobe "$module" &&
		lsmod | awk -v name="$lsmod_name" '$1 == name { found = 1 } END { exit !found }'; then
		printf 'msd-module-check: %s loaded via modprobe and listed by lsmod\n' \
			"$module" >/dev/console
	else
		printf 'msd-module-check: %s modprobe or lsmod failed\n' \
			"$module" >/dev/console
	fi
done
case " $(cat /proc/cmdline) " in
	*" msd.sweep=1 "*)
		printf '<6>MSD/Linux ready\n' > /dev/kmsg
		;;
	*)
		printf '%s\n' 'MSD/Linux ready' > /dev/console
		;;
esac

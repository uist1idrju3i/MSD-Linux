#!/bin/sh

case "${1:-start}" in
	start) ;;
	*) exit 0 ;;
esac

mkdir -p /run/etc-overlay/upper /run/etc-overlay/work /run/etc-overlay/merged
mount -t overlay overlay \
	-o lowerdir=/data/etc:/etc,upperdir=/run/etc-overlay/upper,workdir=/run/etc-overlay/work \
	/run/etc-overlay/merged || {
	printf '%s\n' 'Failed to mount /etc overlay; leaving /etc unchanged' >&2
	exit 1
}
mount -o bind /run/etc-overlay/merged /etc

#!/bin/sh

case "${1:-start}" in
	start) ;;
	*) exit 0 ;;
esac

stop_boot() {
	printf '%s\n' 'Boot stopped. Safe to power off.' >&2
	while :; do sleep 60; done
}

/usr/libexec/msd/early-io gate || stop_boot
state=$(cat /run/msd-early-io/state) || stop_boot
case "$state" in
	ready) mode=product ;;
	hardware-absent-qemu) mode=qemu ;;
	*) stop_boot ;;
esac

/usr/sbin/msd-data-boot start "$mode" || stop_boot
